generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  TECHNICAL_SKILL
  SOFT_SKILL
  LANGUAGE
  TECHNOLOGY
  HOBBY
  ACHIEVEMENT
  WORK_EXPERIENCE
  EDUCATION
  REFEREE
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions       Session[]
  cvs            Cv[]
  items          Item[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Item {
  id           String   @id @default(cuid())
  userId       String
  type         ItemType
  title        String              // short label for checklist
  content      String              // main text (paragraph/bullet/skill)
  tags         String[]            // simple tagging
  sortHint     Int      @default(0)

  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions    ItemRevision[]
  cvLinks      CvItem[]

  @@index([userId, type])
  @@index([userId, deletedAt])
}

model ItemRevision {
  id        String   @id @default(cuid())
  itemId    String
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now())

  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Cv {
  id            String   @id @default(cuid())
  userId        String
  name          String
  // “Header” is global-ish, but store on CV so export is reproducible if you change global later.
  headerName    String
  headerPhone   String
  headerEmail   String
  headerLinks   String   // e.g. "GitHub: ..., LinkedIn: ...", or JSON later

  summary       String   // professional summary (per CV)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CvItem[]
  revisions     CvRevision[]

  @@index([userId, deletedAt])
}

model CvItem {
  id        String   @id @default(cuid())
  cvId      String
  itemId    String
  position  Int      @default(0)
  included  Boolean  @default(true)

  cv        Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([cvId, itemId])
  @@index([cvId, position])
}

model CvRevision {
  id        String   @id @default(cuid())
  cvId      String
  snapshot  Json     // full snapshot of CV + included items at save-time
  createdAt DateTime @default(now())

  cv        Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}
